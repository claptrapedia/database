{
  "name": "claptrapedia-database",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down",
    "migrate": "node --input-type=module -e \"console.log('migrate: placeholder')\"",
    "rebuild": "docker compose down -v && docker compose up -d --wait && pnpm run migrate"
  }
}
